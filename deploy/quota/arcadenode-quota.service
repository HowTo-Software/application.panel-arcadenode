[Unit]
Description=ArcadeNode XFS volume quota driver
RequiresMountsFor=/srv/arcadenode-quota
After=local-fs.target
Before=docker.service

[Service]
ExecStart=/opt/arcadenode-quota/ArcadeNode.Quota
User=root
Group=root
UMask=0077
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=DOTNET_EnableDiagnostics=0
RuntimeDirectory=arcadenode-quota
RuntimeDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ReadWritePaths=/srv/arcadenode-quota /run/arcadenode-quota
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
NoNewPrivileges=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
