# Paths only. Keep secret files outside this repository, readable only by the
# operator and the relevant container UID. Never put passwords in this file.
PANEL_HOST=panel.example.com
# Change deliberately after configuring the host firewall and valid TLS.
PANEL_BIND_IP=127.0.0.1
DATABASE_CONNECTION_FILE=/etc/arcadenode/secrets/runtime-sql.txt
MIGRATION_CONNECTION_FILE=/etc/arcadenode/secrets/migration-sql.txt
JWT_KEY_FILE=/etc/arcadenode/secrets/jwt.txt
ADMIN_PASSWORD_FILE=/etc/arcadenode/secrets/initial-admin.txt
# Choose a distinct bootstrap identity when importing these names from Pterodactyl.
# ARCADENODE_BOOTSTRAP_USERNAME=arcadenode-bootstrap
# ARCADENODE_BOOTSTRAP_EMAIL=arcadenode-bootstrap@panel.local
TLS_CERTIFICATE_FILE=/etc/arcadenode/tls/fullchain.pem
TLS_PRIVATE_KEY_FILE=/etc/arcadenode/tls/privkey.pem
NODE_CONFIG_FILE=/etc/arcadenode/nodes.json
NODE_CERTS_DIR=/etc/arcadenode/nodes
